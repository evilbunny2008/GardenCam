diff --git a/contrib/src/ffmpeg/rules.mak b/contrib/src/ffmpeg/rules.mak
index e4b5595b59..a80b51462d 100644
--- a/contrib/src/ffmpeg/rules.mak
+++ b/contrib/src/ffmpeg/rules.mak
@@ -84,6 +84,13 @@ ifneq ($(findstring amf,$(PKGS)),)
 DEPS_ffmpeg += amf $(DEPS_amf)
 endif
 
+# GardenCam: only the decoders/parsers needed for IP camera streams
+ifdef HAVE_ANDROID
+FFMPEGCONF += --disable-everything \
+	--enable-decoder=h264,hevc,mjpeg,png,aac,aac_latm,pcm_alaw,pcm_mulaw,adpcm_g726,adpcm_g726le \
+	--enable-parser=h264,hevc,mjpeg,png,aac,aac_latm
+endif
+
 # Small size
 ifdef WITH_OPTIMIZATION
 ifdef ENABLE_SMALL
diff --git a/contrib/src/live555/keep-first-session-id.patch b/contrib/src/live555/keep-first-session-id.patch
new file mode 100644
index 0000000000..e7b91c29cb
--- /dev/null
+++ b/contrib/src/live555/keep-first-session-id.patch
@@ -0,0 +1,13 @@
+--- live555/liveMedia/RTSPClient.cpp	2026-11-22 11:39:28.469670637 +1100
++++ live555.modified/liveMedia/RTSPClient.cpp	2026-11-22 11:39:28.492649709 +1100
+@@ -1257,7 +1257,9 @@
+       break;
+     }
+     subsession.setSessionId(sessionId);
+-    delete[] fLastSessionId; fLastSessionId = strDup(sessionId);
++    // Keep the first session ID. Some cameras ("H264DVR" firmware) return a new ID for each
++    // SETUP but only stream on the first, so a PLAY with the last ID gets no data.
++    if (fLastSessionId == NULL) fLastSessionId = strDup(sessionId);
+ 
+     // Also look for an optional "; timeout = " parameter following this:
+     char const* afterSessionId = sessionParamsStr + strlen(sessionId);
